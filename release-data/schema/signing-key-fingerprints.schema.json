{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PHP agent signing key fingerprints",
  "description": "Fingerprints of the keys that sign PHP agent packages.",
  "type": "object",
  "additionalProperties": false,
  "required": ["keys"],
  "properties": {
    "first_signed_version": {
      "description": "First version whose tarballs were signed by the release pipeline.",
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)+$"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["created", "expires", "fingerprint", "name", "public_key_url", "purpose"],
        "properties": {
          "created": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "expires": {
            "description": "A date or the word never.",
            "type": "string",
            "pattern": "^(never|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
          },
          "fingerprint": {
            "description": "Full fingerprint, 40 upper-case hexadecimal digits without spaces.",
            "type": "string",
            "pattern": "^[0-9A-F]{40}$"
          },
          "name": {
            "type": "string"
          },
          "public_key_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "purpose": {
            "enum": ["apt", "rpm", "tarball"]
          }
        }
      }
    }
  }
}
