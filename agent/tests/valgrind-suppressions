# The fatal signal handler reads the PHP stack of a thread whose PHP storage was already freed (the case test_fatal_signal_handler.c
# tests): the read faults on purpose and nr_php_guarded_backtrace_fd catches the signal.
{
   <nr_php_guarded_backtrace_fd: the deliberate read of the freed PHP storage of a thread>
   Memcheck:Addr8
   fun:nr_php_backtrace_fd
   fun:nr_php_guarded_backtrace_fd
   ...
}

# test_fatal_signal_handler.c: the children of its fork tests end on a fatal signal (that is what is tested), so the engine they started,
# and the storage of the thread that raised the signal, are never freed. Valgrind's check for leaks when a process ends cannot be
# switched off by a client request. Only what is allocated under the test's own functions is matched.
{
   <test_fatal_signal_handler: engine started in a child that ends on a signal>
   Memcheck:Leak
   match-leak-kinds: all
   ...
   fun:child_start_engine
}

{
   <test_fatal_signal_handler: the thread that a child starts to raise the signal, never joined>
   Memcheck:Leak
   match-leak-kinds: all
   ...
   fun:child_signal_in_thread
}

